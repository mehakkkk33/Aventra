<% layout("/layouts/boilerplate") %>

<div class="row mt-4">
  <div class="col-8 offset-2 d-flex justify-content-center">
    <h3 class="mb-4"><%= listing.title %></h3>
  </div>
</div>

<div class="col-8 offset-2">
  <div class="card show-card">
    <img 
      src="<%= listing.image?.url || 'https://images.unsplash.com/photo-1507525428034-b723cf961d3e' %>" 
      class="show-img"
    >
    <div class="card-body">
      <p><%= listing.description %></p>
      <p>₹<%= Number(listing.price).toLocaleString("en-IN") %></p>
      <p><%= listing.location %></p>
      <p><%= listing.country %></p>
    </div>
    <br>

    <div>
      <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark btn-sm me-2">Edit</a>
      <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="d-inline">
        <button class="btn btn-dark btn-sm">Delete</button>
      </form>
    </div>

    <div class="col-8 offset-2 text-center">
      <h4 class="mb-3">Leave a Review</h4>

      <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">
        
        <div class="mb-3 mt-3">
          <label for="rating" class="form-label">Rating</label>
          <fieldset class="starability-coinFlip mx-auto">
            <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
            <input type="radio" id="rate1" name="review[rating]" value="1" />
            <label for="rate1" title="1 star">1 star</label>
            <input type="radio" id="rate2" name="review[rating]" value="2" />
            <label for="rate2" title="2 stars">2 stars</label>
            <input type="radio" id="rate3" name="review[rating]" value="3" />
            <label for="rate3" title="3 stars">3 stars</label>
            <input type="radio" id="rate4" name="review[rating]" value="4" />
            <label for="rate4" title="4 stars">4 stars</label>
            <input type="radio" id="rate5" name="review[rating]" value="5" />
            <label for="rate5" title="5 stars">5 stars</label>
          </fieldset>
        </div>

        <div class="mb-3">
          <label for="comment" class="form-label">Comment</label>
          <textarea 
            name="review[comment]" 
            id="comment" 
            rows="5" 
            class="form-control mx-auto"
            style="max-width: 600px;"
            required></textarea>
          <div class="invalid-feedback">Please write a review!</div>
        </div>

        <button class="btn btn-dark mt-2">Submit</button>
      </form>

      <hr/>

      <div class="row g-1">
        <% for (let review of listing.reviews) { %>
          <div class="col-md-6 d-flex">
            <div class="card ratingCard w-100">
              <div class="card-body">
                <h5 class="card-title"><%= review.author.username %></h5>
                <p class="card-text"><%= review.comment %></p>
                <p class="starability-result card-text" data-rating="<%= review.rating %>"></p>
              </div>
              <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" class="mb-3">
                <button class="btn btn-sm btn-dark">Delete</button>
              </form>
            </div>
          </div>
        <% } %>
      </div>

    </div>
  </div>
</div>