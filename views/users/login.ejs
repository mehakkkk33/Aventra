<% layout("layouts/boilerplate") %>

<style>

    /* ===== FORCE WHITE BACKGROUND (OVERRIDES LAYOUT) ===== */
    html, body {
        background: #ffffff !important;
    }

    :root {
        --glass-bg: rgba(255, 255, 255, 0.85);
        --glass-border: rgba(255, 255, 255, 0.5);
        --text-main: #2d3436;
        --text-sub: #636e72;
        --input-bg: rgba(0, 0, 0, 0.05);
        --input-border: rgba(0, 0, 0, 0.1);
    }

    /* ===== DARK MODE (optional) ===== */
    @media (prefers-color-scheme: dark) {
        html, body {
            background: #0f0f0f !important;
        }

        :root {
            --glass-bg: rgba(30, 30, 30, 0.85);
            --glass-border: rgba(255, 255, 255, 0.1);
            --text-main: #ffffff;
            --text-sub: rgba(255, 255, 255, 0.5);
            --input-bg: rgba(255, 255, 255, 0.05);
            --input-border: rgba(255, 255, 255, 0.1);
        }
    }

    /* ===== WRAPPER ===== */
    .login-wrapper {
        min-height: 90vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

    /* ===== MAIN BOX ===== */
    .adventure-box {
        display: flex;
        width: 100%;
        max-width: 900px;
        min-height: 550px;
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 20px 40px rgba(0,0,0,0.1);
        border: 1px solid var(--glass-border);
    }

    /* ===== VIDEO SIDE ===== */
    .video-side {
        flex: 1.2;
        position: relative;
        overflow: hidden;
    }

    .video-side video {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .video-text-overlay {
        position: absolute;
        bottom: 40px;
        left: 40px;
        color: white;
        z-index: 2;
        text-shadow: 0 2px 10px rgba(0,0,0,0.3);
    }

    .video-side::after {
        content: '';
        position: absolute;
        top: 0; left: 0;
        width: 100%; height: 100%;
        background: linear-gradient(to top, rgba(0,0,0,0.6), transparent);
    }

    /* ===== FORM SIDE ===== */
    .form-side {
        flex: 1;
        background: var(--glass-bg);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        padding: 3rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .login-title {
        color: var(--text-main);
        font-weight: 800;
        letter-spacing: 1px;
        font-size: 2rem;
    }

    .login-subtitle {
        color: var(--text-sub);
        margin-bottom: 2rem;
    }

    /* ===== INPUTS ===== */
    .glass-input {
        background: var(--input-bg) !important;
        border: 1px solid var(--input-border) !important;
        color: var(--text-main) !important;
        padding: 0.8rem 1rem;
        border-radius: 12px;
    }

    .glass-input:focus {
        border-color: #4a97cd !important;
        box-shadow: 0 0 15px rgba(74, 151, 205, 0.2);
    }

    .form-label {
        color: var(--text-main);
        opacity: 0.8;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-weight: 600;
    }

    /* ===== BUTTON ===== */
    .login-btn {
        background: linear-gradient(45deg, #4432dd, #4a97cd);
        border: none;
        color: white;
        padding: 0.9rem;
        font-weight: 700;
        border-radius: 12px;
        transition: 0.4s;
    }

    .login-btn:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 20px rgba(68, 50, 221, 0.2);
        color: white;
    }

    /* ===== RESPONSIVE ===== */
    @media (max-width: 768px) {
        .video-side { display: none; }
        .adventure-box { max-width: 450px; }
    }

</style>

<div class="container login-wrapper">
    <div class="adventure-box">

